---
const exploreItems = [
  { text: "Home", href: "/" },
  { text: "Machu Picchu", href: "/machu-picchu" },
  { text: "Tradicionales", href: "/tradicional" },
  { text: "Aventura", href: "/aventura" },
  { text: "Paquetes", href: "/paquetes" },
  { text: "Full Day", href: "/full-day" },
];

const resourceItems = [
  { text: "Política de Privacidad", href: "/politica-de-privacidad" },
  { text: "Términos y Condiciones", href: "/terminos-y-condiciones" },
];

const currentYear = new Date().getFullYear();
---

<footer class="bg-brand-dark text-white">
  <!-- ═══ ZONE 1: CTA Hero ═══ -->
  <div class="max-w-7xl mx-auto px-6 pt-24 pb-20">
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-10">
      <h2
        class="text-4xl sm:text-5xl md:text-7xl font-medium tracking-tight max-w-2xl text-brand-light/90 leading-[1.1]"
      >
        ¿Tienes un viaje en mente?
      </h2>
      <a
        href="https://wa.me/51974346252"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 bg-[#25D366] hover:bg-[#20bd5a] text-white px-8 py-4 rounded-full text-lg font-medium transition-all duration-300 group shadow-[0_4px_14px_0_rgba(37,211,102,0.39)] hover:shadow-[0_6px_20px_rgba(37,211,102,0.23)] hover:-translate-y-1 shrink-0 self-start lg:self-auto"
      >
        Contáctanos por WhatsApp
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1"
        >
          <line x1="7" y1="17" x2="17" y2="7"></line>
          <polyline points="7 7 17 7 17 17"></polyline>
        </svg>
      </a>
    </div>
  </div>

  <!-- ═══ Divider ═══ -->
  <div class="max-w-7xl mx-auto px-6">
    <div class="border-t border-white/10"></div>
  </div>

  <!-- ═══ ZONE 2: Content Grid ═══ -->
  <div class="max-w-7xl mx-auto px-6 py-16">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-12 lg:gap-16">
      <!-- Column 1: Explorar -->
      <div>
        <h3
          class="text-brand-primary text-xs font-bold uppercase tracking-[0.2em] mb-6"
        >
          Explorar
        </h3>
        <ul class="space-y-3">
          {
            exploreItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm text-brand-light/60 hover:text-white transition-colors duration-200"
                >
                  {item.text}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Column 2: Legal -->
      <div>
        <h3
          class="text-brand-primary text-xs font-bold uppercase tracking-[0.2em] mb-6"
        >
          Legal
        </h3>
        <ul class="space-y-3">
          {
            resourceItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm text-brand-light/60 hover:text-white transition-colors duration-200"
                >
                  {item.text}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Column 3: Contacto -->
      <div>
        <h3
          class="text-brand-primary text-xs font-bold uppercase tracking-[0.2em] mb-6"
        >
          Contacto
        </h3>
        <ul class="space-y-3">
          <li class="flex items-start gap-2 text-sm text-brand-light/60">
            <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0 text-brand-primary/70"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            Cusco, Perú
          </li>
          <li>
            <a href="tel:+51974346252" class="flex items-start gap-2 text-sm text-brand-light/60 hover:text-white transition-colors duration-200">
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0 text-brand-primary/70"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              +51 974 346 252
            </a>
          </li>
          <li>
            <a href="mailto:info@exploreperu.com" class="flex items-start gap-2 text-sm text-brand-light/60 hover:text-white transition-colors duration-200">
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0 text-brand-primary/70"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
              info@exploreperu.com
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- ═══ ZONE 3: Bottom Bar ═══ -->
  <div class="border-t border-white/5">
    <div class="max-w-7xl mx-auto px-6 py-8 flex flex-col sm:flex-row justify-between items-center gap-6">
      <p class="text-brand-light/40 text-xs tracking-wide">
        © {currentYear} XPLORE PERÚ. Todos los derechos reservados.
      </p>

      <div class="flex items-center gap-4">
        <!-- TikTok -->
        <a
          href="#"
          aria-label="TikTok"
          class="w-12 h-12 rounded-full border border-white/10 flex items-center justify-center text-brand-light/50 hover:bg-white hover:border-white hover:text-black hover:-translate-y-1 transition-all duration-300"
        >
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path></svg>
        </a>
        <!-- Facebook -->
        <a
          href="#"
          aria-label="Facebook"
          class="w-12 h-12 rounded-full border border-white/10 flex items-center justify-center text-brand-light/50 hover:bg-[#1877F2] hover:border-[#1877F2] hover:text-white hover:-translate-y-1 transition-all duration-300"
        >
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
        </a>
        <!-- YouTube -->
        <a
          href="#"
          aria-label="YouTube"
          class="w-12 h-12 rounded-full border border-white/10 flex items-center justify-center text-brand-light/50 hover:bg-[#FF0000] hover:border-[#FF0000] hover:text-white hover:-translate-y-1 transition-all duration-300"
        >
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>
        </a>
        <!-- Instagram -->
        <a
          href="#"
          aria-label="Instagram"
          class="w-12 h-12 rounded-full border border-white/10 flex items-center justify-center text-brand-light/50 hover:bg-gradient-to-tr hover:from-[#f09433] hover:via-[#dc2743] hover:to-[#bc1888] hover:border-transparent hover:text-white hover:-translate-y-1 transition-all duration-300"
        >
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
        </a>
      </div>
    </div>
  </div>
</footer>
