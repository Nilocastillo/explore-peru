---
import Layout from "@/layout/Layout.astro";
import TourCard from "@/components/TourCard.astro";
import { getCollection } from "astro:content";
import { getLocale, localizePath } from "@/i18n/routes";

interface Props { category?: "all" | "machuPicchu" | "traditional" | "adventure" | "packages" | "fullDay"; }
const { category = "all" } = Astro.props;
const locale = getLocale(Astro.url.pathname);
const english = locale === "en";
const content = {
  all: {
    es: { title: "Tours y experiencias en Perú", description: "Descubre los mejores destinos del Perú con nuestras experiencias únicas, diseñadas para crear recuerdos inolvidables.", start: "Tours &", accent: "Experiencias" },
    en: { title: "Peru Tours & Experiences", description: "Discover the best of Peru with unique experiences designed to create unforgettable memories.", start: "Tours &", accent: "Experiences" },
  },
  machuPicchu: {
    es: { title: "Machu Picchu", description: "Vive la experiencia de conocer la maravilla del mundo con nuestras opciones diseñadas para ti.", start: "Tours a", accent: "Machu Picchu" },
    en: { title: "Machu Picchu Tours", description: "Experience this wonder of the world with Machu Picchu tours designed around your journey.", start: "Machu Picchu", accent: "Tours" },
  },
  traditional: {
    es: { title: "Tradicional", description: "Descubre la historia y cultura a través de nuestros recorridos clásicos y esenciales que no te puedes perder.", start: "Tours", accent: "Tradicionales" },
    en: { title: "Classic Peru Tours", description: "Discover Peru's history and culture on classic tours of its essential sights and landmarks.", start: "Classic", accent: "Tours" },
  },
  adventure: {
    es: { title: "Aventura", description: "Desafía tus límites con nuestras rutas de trekking y experiencias al aire libre en escenarios espectaculares.", start: "Tours de", accent: "Aventura" },
    en: { title: "Peru Adventure Tours", description: "Challenge yourself on trekking routes and outdoor adventures through spectacular landscapes.", start: "Adventure", accent: "Tours" },
  },
  packages: {
    es: { title: "Paquetes", description: "Aprovecha al máximo tu visita con nuestros paquetes que incluyen múltiples destinos y las mejores experiencias.", start: "Paquetes", accent: "Turísticos" },
    en: { title: "Peru Travel Packages", description: "Make the most of your visit with travel packages combining multiple destinations and memorable experiences.", start: "Peru Travel", accent: "Packages" },
  },
  fullDay: {
    es: { title: "Tours Full Day", description: "Aprovecha tu viaje al máximo con nuestras experiencias de un día. Perfectos para quienes tienen el tiempo medido pero muchas ganas de explorar.", start: "Tours", accent: "Full Day" },
    en: { title: "Peru Full-Day Tours", description: "Make the most of your trip with full-day experiences, ideal for travelers with limited time and plenty of curiosity.", start: "Full-Day", accent: "Tours" },
  },
}[category][locale];
const categories = {
  all: { es: "", en: "" },
  machuPicchu: { es: "Machu Picchu", en: "Machu Picchu" },
  traditional: { es: "Tradicional", en: "Traditional" },
  adventure: { es: "Aventura", en: "Adventure" },
  packages: { es: "Paquetes", en: "Packages" },
  fullDay: { es: "Full Day", en: "Full Day" },
};
const contentTours = await getCollection(english ? "toursEn" : "tours");
const tourImages = import.meta.glob<{ default: ImageMetadata }>("/src/assets/**/*.{avif,webp,jpg,jpeg}", { eager: true });
const tours = contentTours
  .filter((tour) => category === "all" || tour.data.category.includes(categories[category][locale]))
  .sort((a, b) => a.data.title.localeCompare(b.data.title, locale))
  .map((tour) => ({
    title: tour.data.title,
    description: tour.data.description,
    days: tour.data.duration,
    difficulty: tour.data.difficulty,
    imageSrc: tourImages[tour.data.image.replace("../../assets/", "/src/assets/")]?.default,
    imageAlt: tour.data.alt,
    href: localizePath(`/tours/${tour.id}`, locale),
  }));
---

<Layout title={`${content.title} | XPLORE PERÚ`} description={content.description}>
  <main id="main-content" class="pt-32 pb-24 px-6 bg-brand-bg min-h-screen">
    <div class="max-w-7xl mx-auto">
      <div class="mb-16 text-center">
        <span class="inline-flex items-center px-4 py-1.5 rounded-full bg-white/80 text-brand-dark text-sm font-bold mb-6 border border-brand-dark/10 shadow-soft">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-primary-dark mr-2" aria-hidden="true"></span>
          {category === "all" ? (english ? "Our Experiences" : "Nuestras Experiencias") : (english ? "Exclusive Collection" : "Colección Exclusiva")}
        </span>
        <h1 class="text-4xl md:text-6xl lg:text-7xl font-medium tracking-tight text-brand-dark leading-[1.1] mb-6">
          {content.start} <span class="text-brand-primary-dark italic">{content.accent}</span>
        </h1>
        <p class="text-lg md:text-xl text-brand-dark-muted max-w-2xl mx-auto">{content.description}</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {tours.length ? tours.map((tour) => <TourCard {...tour} />) : (
          <p class="text-center col-span-full text-brand-dark-muted">{english ? "More tours in this collection are coming soon." : "Próximamente más tours en esta categoría."}</p>
        )}
      </div>
      <div class="mt-16 text-center">
        <a href={localizePath("/consultar", locale)} class="btn-travel px-10 py-4 rounded-full font-bold inline-flex items-center gap-2 shadow-lg transition-all duration-300">
          {english ? "Request Information" : "Solicitar Información"}
          <svg aria-hidden="true" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
        </a>
      </div>
    </div>
  </main>
</Layout>

<style>
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      main :global(article) {
        animation: reveal both;
        animation-timeline: view();
        animation-range: entry 5% cover 30%;
      }
    }
  }

  @keyframes reveal {
    0% {
      opacity: 0;
      translate: 0 100px;
    }

    50% {
      opacity: 0.4;
    }

    to {
      opacity: 1;
      translate: 0 0;
    }
  }
</style>
