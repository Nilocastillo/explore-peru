---
import ConsultationForm from "@/components/forms/ConsultationForm.astro";

interface Props {
  title: string;
  duration: string;
  departure: string;
  price?: string;
}

const { title, duration, departure, price = "Consultar" } = Astro.props;
---

<ConsultationForm tour={title} duration={duration} departure={departure} price={price} />
