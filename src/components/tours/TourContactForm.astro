---
interface Props {
  title: string;
  duration: string;
  departure: string;
  price?: string;
}

const { title, duration, departure, price = "Consultar" } = Astro.props;
---

<form class="tour-contact-form rounded-2xl border border-brand-dark/10 bg-white p-6 shadow-card" data-tour={title}>
  <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand-primary">Reserva este tour</p>
  <h2 class="mt-3 text-2xl font-black leading-tight text-brand-dark">{title}</h2>

  <dl class="mt-5 grid grid-cols-2 gap-3 border-y border-brand-dark/10 py-5 text-sm">
    <div>
      <dt class="font-bold text-brand-dark/50">Duración</dt>
      <dd class="mt-1 font-semibold text-brand-dark">{duration}</dd>
    </div>
    <div>
      <dt class="font-bold text-brand-dark/50">Desde</dt>
      <dd class="mt-1 font-semibold text-brand-primary">{price}</dd>
    </div>
    <div class="col-span-2">
      <dt class="font-bold text-brand-dark/50">Salidas</dt>
      <dd class="mt-1 font-semibold text-brand-dark">{departure}</dd>
    </div>
  </dl>

  <label class="mt-5 block text-sm font-bold text-brand-dark" for="tour-name">Nombre</label>
  <input id="tour-name" class="mt-2 w-full rounded-xl border border-brand-dark/10 bg-brand-bg px-4 py-3 text-sm text-brand-dark outline-none transition focus:border-brand-primary focus:bg-white" name="name" type="text" autocomplete="name" required />

  <label class="mt-4 block text-sm font-bold text-brand-dark" for="tour-phone">WhatsApp</label>
  <input id="tour-phone" class="mt-2 w-full rounded-xl border border-brand-dark/10 bg-brand-bg px-4 py-3 text-sm text-brand-dark outline-none transition focus:border-brand-primary focus:bg-white" name="phone" type="tel" autocomplete="tel" required />

  <label class="mt-4 block text-sm font-bold text-brand-dark" for="tour-date">Fecha tentativa</label>
  <input id="tour-date" class="mt-2 w-full rounded-xl border border-brand-dark/10 bg-brand-bg px-4 py-3 text-sm text-brand-dark outline-none transition focus:border-brand-primary focus:bg-white" name="date" type="date" />

  <button class="btn-brand mt-5 w-full rounded-full px-6 py-3.5 text-sm font-bold" type="submit">
    Solicitar información
  </button>
</form>

<script>
  const contactForms = document.querySelectorAll(".tour-contact-form");

  contactForms.forEach((form) => {
    form.addEventListener("submit", (event) => {
      event.preventDefault();

      const formData = new FormData(form);
      const tour = form.getAttribute("data-tour") ?? "tour";
      const name = formData.get("name")?.toString().trim();
      const phone = formData.get("phone")?.toString().trim();
      const date = formData.get("date")?.toString().trim();
      const message = [
        `Hola, quiero información sobre ${tour}.`,
        name ? `Nombre: ${name}` : "",
        phone ? `WhatsApp: ${phone}` : "",
        date ? `Fecha tentativa: ${date}` : "",
      ].filter(Boolean).join("\n");

      window.open(`https://wa.me/51987654321?text=${encodeURIComponent(message)}`, "_blank", "noopener,noreferrer");
    });
  });
</script>
