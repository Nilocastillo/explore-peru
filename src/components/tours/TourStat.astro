---
interface Props {
  label: string;
  value: string;
}

const { label, value } = Astro.props;
---

<div class="rounded-2xl border border-white/15 bg-white/12 px-5 py-4 text-white backdrop-blur-md">
  <p class="text-xs font-bold uppercase tracking-[0.16em] text-white/60">{label}</p>
  <p class="mt-2 text-lg font-bold leading-tight">{value}</p>
</div>
