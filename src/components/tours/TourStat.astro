---
interface Props {
  label: string;
  value: string;
}

const { label, value } = Astro.props;
---

<div class="flex items-center gap-3">
  <div class="text-brand-primary shrink-0" aria-hidden="true">
    <slot />
  </div>
  <div>
    <p
      class="text-[10px] font-bold uppercase tracking-widest text-brand-dark-muted mt-0.5"
    >
      {label}
    </p>
    <p class="text-sm lg:text-base font-black text-brand-dark leading-tight">
      {value}
    </p>
  </div>
</div>
