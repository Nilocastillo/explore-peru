---
import Layout from "@/layout/Layout.astro";
import ConsultationForm from "@/components/forms/ConsultationForm.astro";
import { getWhatsAppUrl } from "@/data/contact";
import { getLocale } from "@/i18n/routes";

const english = getLocale(Astro.url.pathname) === "en";
const selectedTour = Astro.url.searchParams.get("tour") ?? "";
---

<Layout
  title={english ? "Contact & Cusco Tour Bookings | XPLORE PERÚ" : "Contacto y reservas de tours en Cusco | XPLORE PERÚ"}
  description={english ? "Contact XPLORE PERÚ about Cusco tours, Machu Picchu and travel packages. Send your inquiry or chat with our team on WhatsApp." : "Contacta a XPLORE PERÚ para consultar tours en Cusco, Machu Picchu y paquetes de viaje. Envíanos tu consulta o escríbenos por WhatsApp."}
  showFloatingWhatsApp={false}
>
  <main id="main-content" class="contact-page">
    <section class="contact-layout" aria-labelledby="contact-title">
      <div class="contact-form-panel">
        <div class="contact-intro">
          <p class="contact-eyebrow">{english ? "Contact & bookings" : "Contacto y reservas"}</p>
          <h1 id="contact-title">{english ? "Plan your Cusco trip" : "Consulta tu viaje a Cusco"}</h1>
          <p class="contact-description">{english ? "Tell us which tour interests you and when you would like to travel." : "Cuéntanos qué tour te interesa y cuándo deseas viajar."}</p>
        </div>

        <ConsultationForm tour={selectedTour} layout="contact" />
      </div>

      <aside class="contact-details" aria-labelledby="contact-info-title">
        <h2 id="contact-info-title">{english ? "Contact information" : "Información de contacto"}</h2>
        <dl class="contact-methods">
          <div class="contact-method">
            <dt>
            <span class="contact-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="2.5" /></svg>
            </span>
              {english ? "Location" : "Ubicación"}</dt>
              <dd>{english ? "Cusco, Peru" : "Cusco, Perú"}</dd>
          </div>
          <div class="contact-method">
            <dt>
            <span class="contact-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="5" width="18" height="14" rx="2" /><path stroke-linecap="round" stroke-linejoin="round" d="m3 6 9 7 9-7" /></svg>
            </span>
              {english ? "Email" : "Correo electrónico"}</dt>
              <dd><a href="mailto:info@exploreperu.com">info@exploreperu.com</a></dd>
          </div>
          <div class="contact-method">
            <dt>
            <span class="contact-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5 9 9 0 0 1-4-.9L3 21l1.9-5.5a9 9 0 0 1-.9-4A8.5 8.5 0 0 1 12.5 3H13a8.5 8.5 0 0 1 8 8v.5Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M9 8.5c.5 3 2.5 5 5.5 5.5" /></svg>
            </span>
              WhatsApp</dt>
              <dd><a href={getWhatsAppUrl()} target="_blank" rel="noopener noreferrer">+51 986 206 531</a></dd>
          </div>
          <div class="contact-method">
            <dt>
            <span class="contact-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M22 16.9V20a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2 4.2 2 2 0 0 1 4 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.8 2Z" /></svg>
            </span>
              {english ? "Telephone" : "Teléfono"}</dt>
              <dd><a href="tel:+51974346252">+51 974 346 252</a></dd>
          </div>
        </dl>

        <div class="contact-direct">
          <p>{english ? "Prefer to chat on WhatsApp?" : "¿Prefieres escribir por WhatsApp?"}</p>
          <a href={getWhatsAppUrl()} target="_blank" rel="noopener noreferrer" class="btn-brand contact-whatsapp">
            {english ? "Chat with us" : "Escríbenos"}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M7 7h10v10" /></svg>
          </a>
        </div>
      </aside>
    </section>
  </main>
</Layout>

<style>
  .contact-page {
    padding: 128px 24px 72px;
    background: var(--color-brand-bg);
  }

  .contact-layout {
    display: grid;
    max-width: 1280px;
    margin-inline: auto;
    overflow: hidden;
    border: 1px solid color-mix(in oklch, var(--color-brand-dark) 9%, transparent);
    border-radius: 24px;
    background: var(--color-brand-light);
    box-shadow: var(--shadow-soft);
  }

  .contact-form-panel { min-width: 0; padding: 32px 24px; }
  .contact-intro { margin-bottom: 28px; }
  .contact-eyebrow { margin-bottom: 14px; color: var(--color-brand-primary-dark); font-size: 11px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
  h1 { color: var(--color-brand-dark); font-size: clamp(2rem, 3.2vw, 2.75rem); font-weight: 650; letter-spacing: -.045em; line-height: 1.12; }
  .contact-description { max-width: 36rem; margin-top: 16px; color: var(--color-brand-dark-muted); font-size: 15px; line-height: 1.7; }

  .contact-details {
    min-width: 0;
    padding: 32px 24px;
    border-top: 1px solid color-mix(in oklch, var(--color-brand-primary) 14%, transparent);
    background: var(--color-brand-primary-subtle);
    color: var(--color-brand-dark);
  }

  h2 { max-width: 18rem; font-size: 1.75rem; font-weight: 650; letter-spacing: -.035em; line-height: 1.2; }
  .contact-methods { display: grid; gap: 28px; margin-top: 32px; }
  .contact-method { position: relative; min-width: 0; min-height: 48px; padding-left: 58px; }
  .contact-icon { position: absolute; top: 0; left: 0; display: grid; width: 42px; height: 42px; place-items: center; border: 1px solid color-mix(in oklch, var(--color-brand-primary) 18%, transparent); border-radius: 12px; background: var(--color-brand-light); color: var(--color-brand-primary-dark); }
  .contact-icon svg { width: 21px; height: 21px; }
  dt { margin-bottom: 6px; font-size: 13px; font-weight: 750; line-height: 1.4; }
  dd { color: var(--color-brand-dark-muted); font-size: 15px; line-height: 1.5; }
  dd a { overflow-wrap: anywhere; text-underline-offset: 4px; transition: color .2s; }
  dd a:hover { color: var(--color-brand-primary-dark); text-decoration: underline; }
  .contact-direct { margin-top: 36px; padding-top: 28px; border-top: 1px solid color-mix(in oklch, var(--color-brand-primary) 20%, transparent); }
  .contact-direct p { margin-bottom: 16px; font-size: 14px; line-height: 1.6; }
  .contact-whatsapp { display: inline-flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 48px; width: 100%; padding: 14px 20px; border-radius: 8px; font-size: 14px; font-weight: 700; }
  .contact-whatsapp svg { width: 19px; height: 19px; flex: 0 0 19px; }

  @media (min-width: 640px) {
    .contact-page { padding-inline: 32px; }
    .contact-form-panel, .contact-details { padding: 40px; }
    .contact-methods { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 1024px) {
    .contact-page { padding: 148px 48px 96px; }
    .contact-layout { grid-template-columns: minmax(0, 1.4fr) minmax(320px, .9fr); }
    .contact-form-panel { padding: 44px 40px; }
    .contact-details { padding: 48px 36px; border-top: 0; border-left: 1px solid color-mix(in oklch, var(--color-brand-primary) 14%, transparent); }
    .contact-methods { grid-template-columns: 1fr; margin-top: 36px; }
  }

  @media (min-width: 1280px) {
    .contact-form-panel { padding: 48px 52px; }
    .contact-details { padding-inline: 44px; }
  }
</style>
