---
import { Image } from "astro:assets";
import heroImage from "@/assets/hero-mapi.avif";
import { getWhatsAppUrl } from "@/data/contact";

interface Props {
  title: string;
  description?: string;
  days?: string;
  difficulty?: string;
  imageSrc?: ImageMetadata;
  imageAlt?: string;
  imageSizes?: string;
  href?: string;
}

const {
  title,
  description = "Vive una experiencia única explorando los paisajes más impresionante del Perú con guías locales expertos.",
  days = "1 día",
  difficulty = "Moderada",
  imageSrc = heroImage,
  imageAlt = title,
  imageSizes = "(max-width: 639px) calc(100vw - 3rem), (max-width: 1023px) calc((100vw - 4.5rem) / 2), (max-width: 1279px) calc((100vw - 6rem) / 3), calc((min(100vw, 80rem) - 4.5rem) / 4)",
  href = "/tours",
} = Astro.props;

const whatsappUrl = getWhatsAppUrl(
  `Hola XPLORE PERÚ, quisiera recibir información sobre el tour ${title}.`,
);
---

<article
  class="group relative overflow-hidden rounded-2xl border border-brand-dark/6 bg-white shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-elevated flex flex-col"
>
  <a href={href} class="block">
    <div class="relative aspect-[4/3] overflow-hidden">
      <Image
        src={imageSrc}
        alt={imageAlt}
        class="w-full h-full object-cover transition-all duration-500 group-hover:scale-[1.03]"
        widths={[320, 480, 640, 768, 960]}
        sizes={imageSizes}
        loading="lazy"
        decoding="async"
        quality={70}
      />
      <div
        class="absolute inset-0 bg-brand-dark/0 transition-all duration-300 group-hover:bg-brand-dark/10"
      >
      </div>
      <div class="absolute top-4 right-4">
        <span
          class="inline-flex items-center gap-1 px-3 py-1.5 rounded-full border border-brand-accent/30 bg-white/92 backdrop-blur-sm text-brand-dark text-xs font-bold shadow-md"
        >
          <svg
            aria-hidden="true"
            class="w-3.5 h-3.5 text-amber-500 drop-shadow-[0_0_4px_rgba(245,158,11,0.6)]"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
          Popular
        </span>
      </div>
    </div>
  </a>

  <div class="p-6 flex flex-col flex-grow transition-colors duration-300">
      <h3
        class="text-xl font-bold text-brand-dark group-hover:text-brand-primary-dark transition-colors duration-300 mb-2"
      >
        <a href={href} class="focus-visible:rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary">{title}</a>
      </h3>

      <p
        class="text-sm text-brand-dark-muted leading-relaxed mb-4 line-clamp-2"
      >
        {description}
      </p>

      <div class="flex flex-wrap items-center gap-2 mb-4 text-sm">
        <div class="flex items-center gap-1.5 rounded-full bg-brand-sky-soft px-3 py-1.5 text-brand-dark">
          <svg
            aria-hidden="true"
            class="w-4 h-4 text-brand-primary-dark"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
            ></path>
          </svg>
          <span class="font-medium">{days}</span>
        </div>
        <div class="flex items-center gap-1.5 rounded-full bg-brand-leaf-soft px-3 py-1.5 text-brand-dark">
          <svg
            aria-hidden="true"
            class="w-4 h-4 text-brand-leaf"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"
            ></path>
          </svg>
          <span class="font-medium">{difficulty}</span>
        </div>
      </div>

      <div class="mt-auto grid grid-cols-2 gap-2 border-t border-brand-dark/5 pt-4">
        <a href={href} class="inline-flex min-h-10 items-center justify-center gap-1 whitespace-nowrap rounded-full bg-gradient-to-r from-brand-dark to-brand-dark-soft px-2 py-2 text-xs font-bold text-white transition-all duration-300 hover:from-brand-primary hover:to-brand-primary-dark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary">
          Ver detalles
          <svg aria-hidden="true" class="h-3.5 w-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
        </a>
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Consultar por WhatsApp sobre ${title}`}
          class="inline-flex min-h-10 items-center justify-center gap-1 whitespace-nowrap rounded-full bg-[#25D366] px-2 py-2 text-xs font-bold text-white transition-all duration-300 hover:bg-[#1ebe5d] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#25D366]"
        >
          <svg aria-hidden="true" class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M20.52 3.48A11.88 11.88 0 0 0 12.07 0C5.5 0 .16 5.34.16 11.91c0 2.1.55 4.16 1.6 5.97L0 24l6.28-1.65a11.9 11.9 0 0 0 5.79 1.48h.01c6.56 0 11.91-5.34 11.91-11.91a11.84 11.84 0 0 0-3.47-8.44ZM12.08 21.8h-.01a9.9 9.9 0 0 1-5.05-1.38l-.36-.22-3.72.98.99-3.63-.24-.37a9.84 9.84 0 0 1-1.51-5.27c0-5.45 4.44-9.89 9.9-9.89a9.83 9.83 0 0 1 6.99 2.9 9.83 9.83 0 0 1 2.9 7c0 5.45-4.44 9.88-9.89 9.88Zm5.42-7.4c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47a8.9 8.9 0 0 1-1.65-2.05c-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2-1.42.25-.7.25-1.29.18-1.42-.08-.13-.28-.2-.57-.35Z" /></svg>
          WhatsApp
        </a>
      </div>
  </div>
</article>
