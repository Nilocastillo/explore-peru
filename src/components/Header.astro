---
const navItems = [
  { text: "Machu Picchu", href: "/machu-picchu" },
  { text: "Tradicionales", href: "/tradicional" },
  { text: "Aventura", href: "/aventura" },
  { text: "Paquetes", href: "/paquetes" },
  { text: "Full Day", href: "/full-day" },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header
  class="fixed top-4 md:top-6 left-0 right-0 z-[100] flex justify-center px-4 w-full"
>
  <nav
    class="glass-pill-nav flex items-center font-semibold justify-between gap-4 md:gap-8 max-w-7xl w-full px-6 py-3 text-brand-black"
  >
    <a
      href="/"
      class="flex items-center gap-2 group cursor-pointer text-base"
      onclick="window.scrollTo(0,0)"
    >
      <img
        src="/xplore-logo-horizontal.svg"
        alt="Logotipo Agencia de Viajes XPLORE PERÚ"
        class="h-12 lg:h-16 w-auto object-contain"
        width={350}
        height={146}
        loading="eager"
        decoding="async"
      />
    </a>

    <div class="hidden lg:flex items-center gap-6">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={currentPath === item.href ? "page" : undefined}
            class="px-4 py-2 text-brand-black hover:text-brand-primary transition-colors"
          >
            {item.text}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-1">
      <a
        href="/consultar"
        class="hidden lg:inline-flex btn-brand px-6 py-3 rounded-full text-base font-bold uppercase tracking-wider shadow-lg"
      >
        Contáctanos
      </a>
      <button
        id="mobile-menu-btn"
        type="button"
        aria-label="Abrir menú"
        aria-controls="mobile-menu"
        aria-expanded="false"
        class="lg:hidden w-10 h-10 flex items-center justify-center text-white hover:bg-white/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary rounded-full transition"
      >
        <span class="flex flex-col gap-1.5" aria-hidden="true">
          <span class="w-6 h-0.5 bg-brand-primary rounded"></span>
          <span class="w-6 h-0.5 bg-brand-primary rounded"></span>
          <span class="w-6 h-0.5 bg-brand-primary rounded"></span>
        </span>
      </button>
    </div>
  </nav>
</header>

<!-- Mobile Menu -->
<div
  id="mobile-menu"
  inert
  role="dialog"
  aria-modal="true"
  aria-label="Menú principal"
  class="fixed inset-0 z-[110] bg-brand-dark/95 backdrop-blur-xl transform translate-x-full transition-transform duration-300 flex items-center justify-center"
>
  <button
    id="close-menu"
    type="button"
    aria-label="Cerrar menú"
    class="absolute top-8 right-8 text-white text-2xl w-10 h-10 flex items-center justify-center focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary rounded-full"
  >
    <span class="flex flex-col gap-1.5" aria-hidden="true">
      <span class="w-6 h-0.5 bg-white rounded rotate-45 translate-y-1.5"></span>
      <span class="w-6 h-0.5 bg-white rounded -rotate-45 -translate-y-1.5"
      ></span>
    </span>
  </button>
  <div class="flex flex-col items-center gap-6 w-full px-8 text-center">
    {
      navItems.map((item) => (
        <a
          href={item.href}
          aria-current={currentPath === item.href ? "page" : undefined}
          class="mobile-link text-xl font-medium text-white"
        >
          {item.text}
        </a>
      ))
    }
    <a
      href="/consultar"
      class="mobile-link btn-brand px-8 py-3 rounded-full text-lg font-bold w-full max-w-xs mt-4"
      >Contáctanos</a
    >
  </div>
</div>

<script>
  const mobileMenuBtn = document.getElementById("mobile-menu-btn");
  const closeMenuBtn = document.getElementById("close-menu");
  const mobileMenu = document.getElementById("mobile-menu");
  const mobileLinks = document.querySelectorAll(".mobile-link");

  function setMenuOpen(isOpen: boolean) {
    mobileMenu?.classList.toggle("translate-x-full", !isOpen);
    mobileMenu?.toggleAttribute("inert", !isOpen);
    mobileMenuBtn?.setAttribute("aria-expanded", String(isOpen));

    if (isOpen) {
      closeMenuBtn?.focus();
    } else {
      mobileMenuBtn?.focus();
    }
  }

  mobileMenuBtn?.addEventListener("click", () => {
    const isOpen = mobileMenuBtn.getAttribute("aria-expanded") === "true";
    setMenuOpen(!isOpen);
  });
  closeMenuBtn?.addEventListener("click", () => setMenuOpen(false));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && mobileMenuBtn?.getAttribute("aria-expanded") === "true") {
      setMenuOpen(false);
    }
  });

  mobileLinks.forEach((link) => {
    link.addEventListener("click", () => setMenuOpen(false));
  });
</script>
