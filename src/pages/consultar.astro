---
import Layout from "@/layout/Layout.astro";
import ConsultationForm from "@/components/forms/ConsultationForm.astro";

const selectedTour = Astro.url.searchParams.get("tour") ?? "";
---

<Layout
  title="Consultar viaje | XPLORE PERÚ"
  description="Solicita información personalizada sobre tours, paquetes y experiencias por Perú con XPLORE PERÚ."
>
  <main class="bg-brand-bg px-6 pb-20 pt-32 sm:px-8 lg:px-12">
    <section class="mx-auto max-w-5xl">
      <div class="mb-10 text-center">
        <span class="inline-flex items-center rounded-full border border-brand-primary/20 bg-brand-primary/10 px-4 py-1.5 text-sm font-black uppercase tracking-[0.14em] text-brand-primary">
          Consulta
        </span>
        <h1 class="mx-auto mt-6 max-w-3xl text-5xl font-black leading-[0.98] tracking-tight text-brand-dark sm:text-6xl lg:text-7xl">
          Diseñemos tu viaje por Perú
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-brand-dark-muted">
          Envíanos tus datos, fechas tentativas y el tour que te interesa. Nuestro equipo revisará disponibilidad y te responderá con la mejor opción para tu viaje.
        </p>
      </div>

      <ConsultationForm tour={selectedTour} />
    </section>
  </main>
</Layout>
