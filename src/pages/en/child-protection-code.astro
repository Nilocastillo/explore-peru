---
import esnnaPoster from "@/FICHA-ESNNA.webp";
import Layout from "@/layout/Layout.astro";

export const prerender = true;

const commitments = [
  "We do not promote, facilitate or tolerate any form of sexual exploitation of children and adolescents.",
  "We inform our travelers, staff and suppliers about preventing the sexual exploitation of children and adolescents in tourism.",
  "We select tourism services that respect the dignity, safety and rights of children and adolescents.",
  "We report any indications or suspicious situations that come to our attention to the competent authorities.",
  "We promote responsible experiences that protect communities and the people who live in them.",
];

const legalReferences = [
  {
    title: "Law No. 30802",
    description:
      "Establishes protective measures and provides the basis for tourism providers to be required to sign the Code of Conduct against the sexual exploitation of children and adolescents.",
    href: "https://www.gob.pe/7378",
  },
  {
    title: "Ministerial Resolution No. 430-2018-MINCETUR",
    description:
      "Approves the Code of Conduct against the sexual exploitation of children and adolescents in tourism for tourism service providers.",
    href: "https://www.gob.pe/institucion/mincetur/normas-legales/221115-430-2018-mincetur",
  },
  {
    title: "Law No. 32392",
    description:
      "The New General Tourism Law includes the commitment against the sexual exploitation of children and adolescents among the principles of tourism activity.",
    href: "https://leyes.congreso.gob.pe/Documentos/2021_2026/ADLP/Texto_Consolidado/32392-TXM.pdf",
  },
  {
    title: "Supreme Decree No. 002-2026-MINCETUR",
    description:
      "Approves the current regulations of the New General Tourism Law.",
    href: "https://www.gob.pe/institucion/mincetur/normas-legales/7639308-002-2026-mincetur",
  },
];
---

<Layout
  title="Child Protection Code | XPLORE PERÚ"
  description="Learn about XPLORE PERÚ’s commitment to preventing the sexual exploitation of children and adolescents in tourism."
>
  <main id="main-content" class="bg-brand-bg">
    <section class="px-6 pb-20 pt-40 sm:px-8 lg:px-12 lg:pb-28 lg:pt-48">
      <div class="mx-auto grid max-w-7xl items-center gap-14 lg:grid-cols-[minmax(0,1fr)_400px] lg:gap-20">
        <div>
          <div class="mb-6 flex items-center gap-4">
            <span class="h-px w-16 bg-brand-accent" aria-hidden="true"></span>
            <span class="text-xs font-bold uppercase tracking-[0.22em] text-brand-primary-dark">
              Responsible tourism
            </span>
          </div>
          <h1 class="max-w-4xl text-4xl font-medium leading-[1.08] tracking-tight text-brand-dark sm:text-5xl lg:text-7xl">
            Code to prevent <span class="text-brand-primary-dark italic">child sexual exploitation</span>
          </h1>
          <p class="mt-7 max-w-3xl text-lg leading-8 text-brand-dark-muted sm:text-xl">
            At XPLORE PERÚ, we reject all forms of sexual exploitation of children and adolescents (ESNNA, its Spanish acronym). Protecting their rights is an ethical, social and legal responsibility that we uphold in every tourism experience.
          </p>
          <p class="mt-8 border-l-2 border-brand-accent pl-5 text-base font-bold leading-7 text-brand-dark">
            We do not promote or permit the sexual exploitation of minors in the course of our activities.
          </p>
        </div>

        <aside aria-labelledby="poster-title" class="mx-auto w-full max-w-xs rounded-2xl border border-brand-dark/10 bg-white p-6 shadow-card sm:max-w-sm sm:p-8 lg:max-w-none">
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand-primary-dark">Protect me</p>
          <h2 id="poster-title" class="mt-4 text-3xl font-bold leading-tight text-brand-dark">Responsible tourism</h2>
          <p class="mt-4 text-base leading-7 text-brand-dark-muted">
            Preventing the sexual exploitation of children and adolescents.
          </p>
          <p class="mt-6 border-l-2 border-brand-accent pl-4 text-base font-bold leading-7 text-brand-dark">
            This travel agency does not promote or permit the sexual exploitation of children and adolescents, or any other criminal offense that comes to our attention in the course of our activities, in accordance with Law No. 29408.
          </p>
          <p class="mt-6 text-sm leading-6 text-brand-dark-muted">
            If you know of a case of sexual exploitation involving anyone under 18, report it. Reports may be anonymous. Call 1818 or Hotline 100, free of charge, 24 hours a day.
          </p>
          <details class="mt-6 border-t border-brand-dark/10 pt-4 text-sm leading-6 text-brand-dark-muted">
            <summary class="cursor-pointer font-bold text-brand-dark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-primary">Legal references printed on the poster</summary>
            <ul class="mt-4 list-disc space-y-3 pl-5">
              <li>Law No. 29408, the General Tourism Law, and its regulations approved by Supreme Decree No. 003-2010-MINCETUR.</li>
              <li>Law No. 30963, amending the Criminal Code regarding penalties for sexual exploitation in its various forms and related offenses, with particular emphasis on protecting children, adolescents and women.</li>
              <li>Law No. 30802, establishing conditions for children and adolescents to enter accommodation establishments to safeguard their protection and integrity.</li>
            </ul>
          </details>
          <a
            href={esnnaPoster.src}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 inline-flex text-sm font-bold text-brand-primary-dark underline underline-offset-4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-primary"
          >
            View the official poster (Spanish)
          </a>
        </aside>
      </div>
    </section>

    <section class="border-t border-brand-dark/10 px-6 py-20 sm:px-8 lg:px-12 lg:py-28">
      <div class="mx-auto max-w-7xl">
        <div class="grid gap-10 lg:grid-cols-[280px_minmax(0,1fr)] lg:gap-20">
          <div>
            <span class="text-xs font-bold uppercase tracking-[0.2em] text-brand-primary-dark">Our position</span>
            <h2 class="mt-4 text-3xl font-medium leading-tight text-brand-dark">
              Protecting children and adolescents
            </h2>
          </div>
          <div class="max-w-3xl text-lg leading-8 text-brand-dark-muted">
            <p>
              The sexual exploitation of minors is a serious violation of their rights and a criminal offense punishable under Peruvian law. No tourism activity may be used to promote, facilitate or conceal it.
            </p>
            <p class="mt-5">
              As a travel agency, we take a zero-tolerance approach and promote tourism that is safe, ethical and respectful of the communities we visit.
            </p>
          </div>
        </div>

        <section class="mt-24 border-t border-brand-dark/10 pt-20" aria-labelledby="commitment-title">
          <div class="grid gap-10 lg:grid-cols-[280px_minmax(0,1fr)] lg:gap-20">
            <div>
              <span class="text-xs font-bold uppercase tracking-[0.2em] text-brand-primary-dark">Concrete actions</span>
              <h2 id="commitment-title" class="mt-4 text-3xl font-medium leading-tight text-brand-dark">
              Our commitment as a travel agency
              </h2>
            </div>

            <ol class="border-t border-brand-dark/10">
              {commitments.map((commitment, index) => (
                <li class="grid grid-cols-[2.5rem_1fr] gap-4 border-b border-brand-dark/10 py-5 sm:grid-cols-[3.5rem_1fr] sm:py-6">
                  <span class="text-sm font-black text-brand-primary-dark" aria-hidden="true">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <span class="text-base font-semibold leading-7 text-brand-dark-muted">{commitment}</span>
                </li>
              ))}
            </ol>
          </div>
        </section>

        <section class="mt-24 border-t border-brand-dark/10 pt-20" aria-labelledby="legal-title">
          <div class="grid gap-10 lg:grid-cols-[280px_minmax(0,1fr)] lg:gap-20">
            <div>
              <span class="text-xs font-bold uppercase tracking-[0.2em] text-brand-primary-dark">Legal framework</span>
              <h2 id="legal-title" class="mt-4 text-3xl font-medium leading-tight text-brand-dark">
                Legislation that guides this commitment
              </h2>
            </div>

            <div>
              <p class="max-w-3xl text-lg leading-8 text-brand-dark-muted">
                Our actions align with MINCETUR’s Code of Conduct and the current Peruvian framework for preventing the sexual exploitation of children and adolescents in tourism.
              </p>
              <div class="mt-8 border-t border-brand-dark/10">
                {legalReferences.map((reference) => (
                  <a
                    href={reference.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group grid gap-2 border-b border-brand-dark/10 py-6 transition sm:grid-cols-[13rem_1fr_auto] sm:items-start sm:gap-6"
                  >
                    <h3 class="font-black text-brand-dark transition group-hover:text-brand-primary-dark">{reference.title}</h3>
                    <p class="text-sm leading-6 text-brand-dark-muted">{reference.description}</p>
                    <svg aria-hidden="true" class="hidden h-5 w-5 text-brand-primary-dark sm:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H18m0 0v4.5M18 6l-7.5 7.5M6 7.5v9A1.5 1.5 0 0 0 7.5 18h9a1.5 1.5 0 0 0 1.5-1.5V12"></path>
                    </svg>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </section>
      </div>
    </section>

    <section class="border-t border-brand-dark/10 bg-white px-6 py-20 sm:px-8 lg:px-12 lg:py-24" aria-labelledby="report-title">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end lg:gap-20">
        <div>
          <span class="text-xs font-bold uppercase tracking-[0.2em] text-brand-primary-dark">Prevention and reporting</span>
          <h2 id="report-title" class="mt-4 max-w-3xl text-3xl font-medium leading-tight text-brand-dark sm:text-5xl">
              If you suspect a case, report it
          </h2>
          <p class="mt-5 max-w-3xl text-lg leading-8 text-brand-dark-muted">
            If you know of a possible case of exploitation or a situation that violates the rights of a child or adolescent, inform the authorities. Reports can be made free of charge.
          </p>
        </div>

        <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
          <a href="tel:1818" class="btn-travel inline-flex items-center justify-center gap-3 rounded-full px-7 py-4 text-sm font-bold">
            Reporting Hotline 1818
            <svg aria-hidden="true" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102A1.125 1.125 0 0 0 5.872 2.25H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"></path></svg>
          </a>
          <a href="tel:100" class="inline-flex items-center justify-center gap-3 rounded-full border border-brand-dark/15 px-7 py-4 text-sm font-bold text-brand-dark transition hover:border-brand-primary hover:text-brand-primary-dark">
            Hotline 100
            <svg aria-hidden="true" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102A1.125 1.125 0 0 0 5.872 2.25H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"></path></svg>
          </a>
          <a
            href="https://www.gob.pe/908-central-unica-de-denuncias-cud"
            target="_blank"
            rel="noopener noreferrer"
            class="text-center text-sm font-bold text-brand-dark-muted underline decoration-brand-dark/20 underline-offset-4 transition hover:text-brand-primary-dark"
          >
            Official information
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
