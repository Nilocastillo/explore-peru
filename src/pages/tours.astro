---
import Layout from "@/layout/Layout.astro";
import TourCard from "@/components/TourCard.astro";
import { getCollection } from "astro:content";

const contentTours = await getCollection("tours");

const tourImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{avif,webp,jpg,jpeg,png}",
  {
    eager: true,
  },
);

function resolveTourImage(imagePath: string) {
  const normalizedPath = imagePath.startsWith("../../assets/")
    ? imagePath.replace("../../assets/", "/src/assets/")
    : imagePath;

  return tourImages[normalizedPath]?.default;
}

const featuredTourOrder = [
  "machupicchufullday",
  "city-tour-cusco",
  "valle-sagrado-de-los-incas",
  "maras-y-moray",
  "valle-sur-cusco",
  "laguna-humantay",
  "montana-de-colores-vinicunca",
  "7-lagunas-ausangate",
  "palcoyo-montana-de-colores",
];

const allTours = featuredTourOrder
  .map((id) => contentTours.find((tour) => tour.id === id))
  .filter((tour) => tour !== undefined)
  .map((tour) => ({
    title: tour.data.title,
    description: tour.data.description,
    days: tour.data.duration,
    difficulty: tour.data.difficulty,
    price: tour.data.price ?? "Consultar",
    imageSrc: resolveTourImage(tour.data.image),
    href: `/tours/${tour.id}`,
  }));
---

<Layout>
  <section class="pt-32 pb-24 px-6 bg-brand-bg min-h-screen">
    <div class="max-w-7xl mx-auto">
      <div class="mb-16 text-center">
        <span
          class="inline-flex items-center px-4 py-1.5 rounded-full bg-brand-primary/10 text-brand-primary text-sm font-semibold mb-6 border border-brand-primary/20"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-brand-primary mr-2"></span>
          Nuestras Experiencias
        </span>
        <h1
          class="text-4xl md:text-6xl lg:text-7xl font-medium tracking-tight text-brand-dark leading-[1.1] mb-6"
        >
          Tours & <span class="text-brand-primary italic">Experiencias</span>
        </h1>
        <p class="text-lg md:text-xl text-brand-dark-muted max-w-2xl mx-auto">
          Descubre los mejores destinos del Perú con nuestras experiencias
          únicas, diseñadas para crear recuerdos inolvidables.
        </p>
      </div>

      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6"
      >
        {allTours.map((tour) => <TourCard {...tour} />)}
      </div>

      <div class="mt-16 text-center">
        <a
          href="/#contacto"
          class="btn-brand px-10 py-4 rounded-full font-bold inline-flex items-center gap-2 shadow-lg hover:-translate-y-0.5 hover:shadow-xl hover:shadow-brand-primary/20 transition-all duration-300"
        >
          Solicitar Información
          <svg
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      section :global(article) {
        animation: reveal both;
        animation-timeline: view();
        animation-range: entry 5% cover 30%;
      }
    }
  }

  @keyframes reveal {
    0% {
      opacity: 0;
      translate: 0 100px;
    }

    50% {
      opacity: 0.4;
    }

    to {
      opacity: 1;
      translate: 0 0;
    }
  }
</style>
