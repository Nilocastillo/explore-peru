---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";

import heroImage from "@/assets/hero-mapi.avif";
import Layout from "@/layout/Layout.astro";
import TourContactForm from "@/components/tours/TourContactForm.astro";
import TourStat from "@/components/tours/TourStat.astro";

export const prerender = true;

const tourImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{avif,webp,jpg,jpeg,png}",
  {
    eager: true,
  },
);

function resolveTourImage(imagePath: string) {
  const normalizedPath = imagePath.startsWith("../../assets/")
    ? imagePath.replace("../../assets/", "/src/assets/")
    : imagePath;

  return tourImages[normalizedPath]?.default ?? heroImage;
}

export async function getStaticPaths() {
  const tours = await getCollection("tours");

  return tours.map((tour) => ({
    params: { slug: tour.id },
    props: { tour },
  }));
}

const { tour } = Astro.props;
const { Content } = await render(tour);
const data = tour.data;
const imageSrc = resolveTourImage(data.image);
const consultationUrl = `/consultar?tour=${encodeURIComponent(data.title)}`;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  name: data.title,
  description: data.meta_description,
  url: Astro.url.href,
  touristType: data.category,
  provider: {
    "@type": "TravelAgency",
    name: "XPLORE PERÚ",
    url: Astro.site?.toString() ?? Astro.url.origin,
  },
  itinerary: {
    "@type": "ItemList",
    itemListElement: [
      "Cusco",
      "Ollantaytambo",
      "Aguas Calientes",
      "Machu Picchu",
      "Cusco",
    ].map((name, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name,
    })),
  },
  offers: data.price
    ? {
        "@type": "Offer",
        price: data.price.replace(/[^0-9.]/g, ""),
        priceCurrency: "USD",
        availability: "https://schema.org/InStock",
      }
    : undefined,
};
---

<Layout
  title={data.meta_title}
  description={data.meta_description}
  type="article"
>
  <main class="bg-brand-bg">
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />

    <section class="relative min-h-[80svh] bg-brand-bg">
      <div class="absolute inset-0 overflow-hidden">
        <Image
          src={imageSrc}
          alt={data.alt}
          class="h-full w-full object-cover"
          widths={[375, 768, 1280, 1920]}
          sizes="100vw"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          quality={78}
        />
        <div
          class="absolute inset-0 z-[1] bg-linear-to-t from-brand-dark/85 via-brand-dark/35 to-transparent"
          aria-hidden="true"
        >
        </div>
      </div>

      <div
        class="relative z-10 mx-auto flex min-h-[80svh] max-w-7xl flex-col justify-end px-6 pb-72 pt-32 sm:px-8 lg:pb-44 lg:px-12"
      >
        <div class="max-w-4xl">
          <h1
            class="tour-hero-title text-5xl font-black uppercase leading-snug sm:text-6xl lg:text-8xl"
          >
            {data.title}
          </h1>
        </div>
      </div>

      <div
        class="absolute z-20 bottom-6 left-1/2 w-full max-w-7xl -translate-x-1/2 rounded-2xl bg-white shadow-xl lg:-bottom-0 lg:w-full lg:translate-y-1/2"
      >
        <div class="flex-1 rounded-2xl">
          <div
            class="grid grid-cols-2 gap-y-6 gap-x-2 py-6 px-4 lg:flex lg:justify-between lg:h-full lg:min-w-max lg:items-center lg:divide-x lg:divide-brand-dark/10 lg:px-0 lg:py-6"
          >
            <div class="px-0 sm:px-4 lg:px-12">
              <TourStat label="Duración" value={data.duration}>
                <svg
                  class="h-8 w-8"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.5"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"
                  ></path></svg
                >
              </TourStat>
            </div>
            <div class="px-0 sm:px-4 lg:px-12">
              <TourStat label="Dificultad" value={data.difficulty}>
                <svg
                  class="h-8 w-8"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.5"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z"
                  ></path></svg
                >
              </TourStat>
            </div>
            <div class="px-0 sm:px-4 lg:px-12">
              <TourStat label="Salidas" value={data.departure}>
                <svg
                  class="h-8 w-8"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.5"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"
                  ></path></svg
                >
              </TourStat>
            </div>
            <div class="px-0 sm:px-4 lg:px-12">
              <TourStat label="Desde" value={data.price ?? "Consultar"}>
                <svg
                  class="h-8 w-8"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.5"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                  ></path></svg
                >
              </TourStat>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="px-6 py-16 sm:px-8 lg:px-12 lg:py-24 bg-brand-bg">
      <div
        class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[minmax(0,1fr)_360px]"
      >
        <article class="min-w-0">
          <div class="tour-copy">
            <Content />
          </div>
        </article>

        <aside class="lg:sticky lg:top-28 lg:self-start pt-8">
          <TourContactForm
            title={data.title}
            duration={data.duration}
            departure={data.departure}
            price={data.price}
          />
        </aside>
      </div>
    </section>
  </main>

  <style>
    .tour-hero-title {
      display: inline-block;
      margin: -0.04em -0.14em -0.16em;
      padding: 0.04em 0.14em 0.16em;
      color: transparent;
      background: linear-gradient(
        180deg,
        var(--color-brand-light) 0%,
        var(--color-brand-light) 50%,
        color-mix(in srgb, var(--color-brand-accent) 95%, var(--color-brand-light))
          100%
      );
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      text-shadow:
        0 0 1px color-mix(in srgb, var(--color-brand-light) 60%, transparent),
        0 2px 18px color-mix(in srgb, var(--color-brand-accent) 55%, transparent),
        0 6px 40px color-mix(in srgb, var(--color-brand-accent) 25%, transparent);
    }

    .tour-copy :global(p) {
      color: var(--color-brand-dark-muted);
      font-size: 1.0625rem;
      line-height: 1.85;
    }

    .tour-copy :global(section + section) {
      margin-top: 4rem;
      padding-top: 4rem;
      border-top: 1px solid
        color-mix(in oklch, var(--color-brand-dark) 10%, transparent);
    }

    .tour-copy :global(p + p) {
      margin-top: 1.15rem;
    }

    .tour-copy :global(strong) {
      color: var(--color-brand-dark);
      font-weight: 800;
    }
  </style>
</Layout>
