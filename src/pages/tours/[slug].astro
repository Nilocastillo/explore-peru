---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";

import heroImage from "@/assets/hero-mapi.avif";
import Layout from "@/layout/Layout.astro";
import TourContactForm from "@/components/tours/TourContactForm.astro";
import TourStat from "@/components/tours/TourStat.astro";

const tourImages = import.meta.glob<{ default: ImageMetadata }>("/src/assets/**/*.{avif,webp,jpg,jpeg,png}", {
  eager: true,
});

function resolveTourImage(imagePath: string) {
  const normalizedPath = imagePath.startsWith("../../assets/")
    ? imagePath.replace("../../assets/", "/src/assets/")
    : imagePath;

  return tourImages[normalizedPath]?.default ?? heroImage;
}

export async function getStaticPaths() {
  const tours = await getCollection("tours");

  return tours.map((tour) => ({
    params: { slug: tour.id },
    props: { tour },
  }));
}

const { tour } = Astro.props;
const { Content } = await render(tour);
const data = tour.data;
const imageSrc = resolveTourImage(data.image);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  name: data.title,
  description: data.meta_description,
  url: Astro.url.href,
  touristType: data.category,
  provider: {
    "@type": "TravelAgency",
    name: "XPLORE PERÚ",
    url: Astro.site?.toString() ?? Astro.url.origin,
  },
  itinerary: {
    "@type": "ItemList",
    itemListElement: [
      "Cusco",
      "Ollantaytambo",
      "Aguas Calientes",
      "Machu Picchu",
      "Cusco",
    ].map((name, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name,
    })),
  },
  offers: data.price
    ? {
        "@type": "Offer",
        price: data.price.replace(/[^0-9.]/g, ""),
        priceCurrency: "USD",
        availability: "https://schema.org/InStock",
      }
    : undefined,
};
---

<Layout title={data.meta_title} description={data.meta_description} type="article">
  <main class="bg-brand-bg">
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <section class="relative min-h-[88svh] overflow-hidden">
      <div class="absolute inset-0">
        <Image
          src={imageSrc}
          alt={data.alt}
          class="h-full w-full object-cover"
          widths={[375, 768, 1280, 1920]}
          sizes="100vw"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          quality={78}
        />
        <div class="absolute inset-0 bg-linear-to-t from-brand-dark via-brand-dark/58 to-brand-dark/18"></div>
      </div>

      <div class="relative z-10 mx-auto flex min-h-[88svh] max-w-7xl flex-col justify-end px-6 pb-12 pt-32 sm:px-8 lg:px-12">
        <a href="/tours" class="mb-8 inline-flex w-fit items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-2 text-sm font-bold text-white backdrop-blur-sm transition hover:bg-white/16">
          <svg class="h-4 w-4" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5m0 0 7-7m-7 7 7 7"></path>
          </svg>
          Tours
        </a>

        <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_380px] lg:items-end">
          <div>
            <span class="inline-flex items-center gap-2 rounded-full border border-brand-primary/30 bg-brand-primary/15 px-4 py-1.5 text-sm font-bold text-brand-primary-light backdrop-blur-sm">
              <span class="h-1.5 w-1.5 rounded-full bg-brand-primary-light"></span>
              {data.badge ?? "Experiencia Xplore"}
            </span>
            <h1 class="mt-6 max-w-4xl text-5xl font-black leading-[0.96] tracking-tight text-white sm:text-6xl lg:text-8xl">
              {data.title}
            </h1>
            <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/78 md:text-xl">
              {data.description}
            </p>
            <div class="mt-6 flex flex-wrap gap-2">
              {data.category.map((category) => (
                <span class="rounded-full border border-white/15 bg-white/10 px-3 py-1 text-xs font-bold uppercase tracking-[0.14em] text-white/70 backdrop-blur-sm">
                  {category}
                </span>
              ))}
            </div>
          </div>

          <aside class="rounded-3xl border border-white/16 bg-white/10 p-4 shadow-glass backdrop-blur-md">
            <div class="grid grid-cols-2 gap-3">
              <TourStat label="Duración" value={data.duration} />
              <TourStat label="Dificultad" value={data.difficulty} />
              <TourStat label="Salidas" value={data.departure} />
              <TourStat label="Desde" value={data.price ?? "Consultar"} />
            </div>
            <a href="/#contacto" class="btn-brand mt-4 flex w-full items-center justify-center rounded-full px-6 py-4 text-sm font-bold shadow-lg">
              Solicitar información
            </a>
          </aside>
        </div>
      </div>
    </section>

    <section class="px-6 py-16 sm:px-8 lg:px-12 lg:py-24">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[minmax(0,1fr)_360px]">
        <article class="min-w-0">
          <div class="tour-copy">
            <Content />
          </div>
        </article>

        <aside class="lg:sticky lg:top-28 lg:self-start">
          <TourContactForm title={data.title} duration={data.duration} departure={data.departure} price={data.price} />
        </aside>
      </div>
    </section>
  </main>
</Layout>

<style>
  .tour-copy :global(p) {
    color: var(--color-brand-dark-muted);
    font-size: 1.0625rem;
    line-height: 1.85;
  }

  .tour-copy :global(section + section) {
    margin-top: 4rem;
    padding-top: 4rem;
    border-top: 1px solid color-mix(in oklch, var(--color-brand-dark) 10%, transparent);
  }

  .tour-copy :global(p + p) {
    margin-top: 1.15rem;
  }

  .tour-copy :global(strong) {
    color: var(--color-brand-dark);
    font-weight: 800;
  }
</style>
