---
import Layout from "@/layout/Layout.astro";
import TourCard from "@/components/TourCard.astro";
import { getCollection } from "astro:content";

const contentTours = await getCollection("tours");

const tourImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{avif,webp,jpg,jpeg}",
  {
    eager: true,
  },
);

function resolveTourImage(imagePath: string) {
  const normalizedPath = imagePath.startsWith("../../assets/")
    ? imagePath.replace("../../assets/", "/src/assets/")
    : imagePath;

  return tourImages[normalizedPath]?.default;
}

// Filtramos por la categoría "Tradicional"
const filteredTours = contentTours
  .filter((tour) => tour.data.category?.includes("Tradicional"))
  .map((tour) => ({
    title: tour.data.title,
    description: tour.data.description,
    days: tour.data.duration,
    difficulty: tour.data.difficulty,
    price: tour.data.price ?? "Consultar",
    imageSrc: resolveTourImage(tour.data.image),
    imageAlt: tour.data.alt,
    href: `/tours/${tour.id}`,
  }));
---

<Layout title="Tradicional | XPLORE PERÚ" description="Descubre nuestros tours tradicionales. Recorridos clásicos e históricos en Perú.">
  <section class="pt-32 pb-24 px-6 bg-brand-bg min-h-screen">
    <div class="max-w-7xl mx-auto">
      <div class="mb-16 text-center">
        <span
          class="inline-flex items-center px-4 py-1.5 rounded-full bg-white/80 text-brand-dark text-sm font-bold mb-6 border border-brand-dark/10 shadow-soft"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-brand-primary-dark mr-2"></span>
          Categoría
        </span>
        <h1
          class="text-4xl md:text-6xl lg:text-7xl font-medium tracking-tight text-brand-dark leading-[1.1] mb-6"
        >
          Tours <span class="text-brand-primary-dark italic">Tradicionales</span>
        </h1>
        <p class="text-lg md:text-xl text-brand-dark-muted max-w-2xl mx-auto">
          Descubre la historia y cultura a través de nuestros recorridos clásicos y esenciales que no te puedes perder.
        </p>
      </div>

      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6"
      >
        {filteredTours.length > 0 ? (
          filteredTours.map((tour) => <TourCard {...tour} />)
        ) : (
          <p class="text-center col-span-full text-brand-dark-muted">Próximamente más tours en esta categoría.</p>
        )}
      </div>

      <div class="mt-16 text-center">
        <a
          href="/consultar"
          class="btn-travel px-10 py-4 rounded-full font-bold inline-flex items-center gap-2 shadow-lg transition-all duration-300"
        >
          Solicitar Información
          <svg
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      section :global(article) {
        animation: reveal both;
        animation-timeline: view();
        animation-range: entry 5% cover 30%;
      }
    }
  }

  @keyframes reveal {
    0% {
      opacity: 0;
      translate: 0 100px;
    }

    50% {
      opacity: 0.4;
    }

    to {
      opacity: 1;
      translate: 0 0;
    }
  }
</style>
