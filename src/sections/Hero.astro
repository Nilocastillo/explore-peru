---
import { Image } from "astro:assets";
import heroImage from "@/assets/hero-mapi.avif";
---

<section class="relative h-svh w-full overflow-hidden">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 bottom-0 z-30 h-0.5 bg-linear-to-r from-transparent via-[#c7a86b] to-transparent"
  >
  </div>

  <!-- Background Image -->
  <div class="hero-bg-mask absolute inset-0 z-0">
    <Image
      id="hero-bg"
      src={heroImage}
      alt="Amanecer en la Ciudadela de Machu Picchu"
      class="w-full h-full object-cover"
      widths={[375, 768, 1280, 1800]}
      sizes="100vw"
      loading="eager"
      decoding="async"
      fetchpriority="high"
      quality={70}
    />
    <div
      class="absolute inset-0 bg-linear-to-t from-brand-dark/70 via-brand-dark/30 to-brand-dark/10"
    >
    </div>
  </div>

  <div
    class="hero-bottom-darken pointer-events-none absolute inset-x-0 bottom-0 z-[2] h-[48%]"
    aria-hidden="true"
  >
  </div>

  <!-- Content Container -->
  <div
    class="relative z-10 h-full w-full max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 flex flex-col justify-end pb-36 md:pb-44"
  >
    <!-- Layout: texto izquierda, botones derecha abajo -->
    <div
      class="flex flex-col md:flex-row md:items-end md:justify-between gap-8 md:gap-12"
    >
      <!-- Bloque de texto -->
      <div class="max-w-2xl">
        <div
          class="hero-fade mb-4 flex items-center gap-4 md:mb-5"
          style="animation-delay: 0.1s"
        >
          <span
            class="h-px w-20 bg-linear-to-l from-brand-accent via-brand-accent/85 to-transparent"
            aria-hidden="true"></span>
          <span
            class="text-primary-glow inline-block font-semibold tracking-[0.25em] uppercase text-xs md:text-sm"
          >
            Viajes extraordinarios
          </span>
        </div>

        <h1
          class="hero-fade hero-title text-5xl sm:text-7xl lg:text-8xl xl:text-9xl font-black leading-[0.92] tracking-tight mb-6 md:mb-8"
          style="animation-delay: 0.25s"
        >
          <span class="hero-title-line">Descubre</span>
          <span class="hero-title-line">Perú</span>
        </h1>

        <p
          class="hero-fade text-base md:text-lg text-white/75 font-light max-w-lg leading-relaxed"
          style="animation-delay: 0.4s"
        >
          Paquetes de viaje diseñados para quienes buscan experiencias
          auténticas. Desde las alturas de Cusco hasta la inmensidad del
          Amazonas.
        </p>
      </div>

      <!-- Botones — esquina inferior derecha en desktop -->
      <div
        class="hero-fade flex flex-col sm:flex-row md:flex-col gap-3 md:gap-4 shrink-0"
        style="animation-delay: 0.55s"
      >
        <a
          href="#tours"
          class="group btn-brand px-8 py-4 rounded-full font-bold text-center flex items-center justify-center gap-2 text-sm md:text-base"
        >
          Explorar Tours
          <svg
            aria-hidden="true"
            class="w-4 h-4 group-hover:translate-x-1 transition-transform"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 z-[1] h-32 bg-linear-to-b from-transparent via-brand-bg/70 to-brand-bg"
  >
  </div>
</section>

<style>
  #hero-bg {
    will-change: transform;
    transform-origin: center;
    transition: transform 0.1s ease-out;
  }

  .hero-fade {
    opacity: 0;
    transform: translateY(20px);
    animation: heroFadeIn 0.8s ease-out forwards;
  }

  .hero-title {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-title-line {
    display: block;
    padding-block: 0.025em;
    color: var(--color-brand-light);
    text-shadow:
      0 0 1px color-mix(in srgb, var(--color-brand-light) 55%, transparent),
      0 1px 7px color-mix(in srgb, var(--color-brand-accent) 34%, transparent),
      0 3px 14px color-mix(in srgb, var(--color-brand-accent) 16%, transparent);
  }

  .hero-bg-mask {
    -webkit-mask-image: linear-gradient(
      to bottom,
      black 0%,
      black 68%,
      color-mix(in srgb, black 80%, transparent) 80%,
      color-mix(in srgb, black 35%, transparent) 92%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      black 0%,
      black 68%,
      color-mix(in srgb, black 80%, transparent) 80%,
      color-mix(in srgb, black 35%, transparent) 92%,
      transparent 100%
    );
  }

  .hero-bottom-darken {
    background: linear-gradient(
      to bottom,
      transparent 0%,
      color-mix(in oklch, var(--color-brand-dark) 34%, transparent) 48%,
      color-mix(in oklch, var(--color-brand-dark) 68%, transparent) 78%,
      color-mix(in oklch, var(--color-brand-dark) 82%, transparent) 100%
    );
  }

  @keyframes heroFadeIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  const MAX_SCALE = 0.18;
  let ticking = false;

  const heroBg = document.getElementById("hero-bg");
  const heroSection = heroBg?.closest("section");

  if (heroBg && heroSection) {
    const update = () => {
      const heroHeight = heroSection.offsetHeight || window.innerHeight;
      const progress = Math.min(Math.max(window.scrollY / heroHeight, 0), 1);

      heroBg.style.transform = `scale(${1 + progress * MAX_SCALE})`;
      ticking = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          window.requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true },
    );
  }
</script>
