---
import BookIcon from "@/assets/icons/book.svg";
import GuiasIcon from "@/assets/icons/guias.svg";
import HeadsetIcon from "@/assets/icons/headset.svg";

const highlights = [
  {
    title: "Itinerarios Personalizados",
    description:
      "Diseñamos cada viaje a tu medida, ajustándonos a tus gustos y presupuesto para crear experiencias únicas.",
    Icon: BookIcon,
    number: "01",
  },
  {
    title: "Guías Expertos Locales",
    description:
      "Contamos con los mejores expertos locales que te mostrarán el Perú auténtico más allá de las rutas turísticas.",
    Icon: GuiasIcon,
    number: "02",
  },
  {
    title: "Soporte 24/7",
    description:
      "Tu tranquilidad es nuestra prioridad. Estamos disponibles a cualquier hora para asistirte durante todo tu viaje.",
    Icon: HeadsetIcon,
    number: "03",
  },
];
---

<section class="py-28 px-6">
  <div class="max-w-7xl mx-auto">
    <!-- Header Area -->
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-8 mb-20">
      <div>
        <span
          class="inline-flex items-center px-4 py-1.5 rounded-full bg-brand-primary/10 text-brand-primary-dark text-sm font-bold mb-6 border border-brand-primary/20 backdrop-blur-sm"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-brand-primary-dark mr-2" aria-hidden="true"></span>
          Lo que ofrecemos
        </span>
        <h2
          class="text-4xl md:text-6xl font-medium tracking-tight text-brand-dark leading-[1.1] max-w-2xl"
        >
          Qué Esperar De Tu Próxima <span class="text-primary-glow italic"
            >Aventura</span
          > Con Nosotros
        </h2>
      </div>
      <p class="text-lg text-brand-dark-muted leading-relaxed max-w-md lg:text-right">
        Más de <strong class="text-brand-dark font-semibold">500 viajeros</strong> confían en nosotros cada año para descubrir lo mejor del Perú.
      </p>
    </div>

    <!-- Features Grid -->
    <div
      class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8"
    >
      {
        highlights.map((item) => (
          <div class="group relative bg-white rounded-3xl p-8 lg:p-10 border border-brand-dark/5 hover:border-brand-accent/50 transition-all duration-500 hover:shadow-elevated overflow-hidden">
            <!-- Gold accent line on hover -->
            <div class="absolute top-0 left-8 right-8 h-px bg-gradient-to-r from-transparent via-brand-accent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500" aria-hidden="true"></div>

            <!-- Number -->
            <span class="block text-5xl font-black text-brand-dark-muted/60 mb-6 select-none transition-colors duration-500 group-hover:text-brand-primary-dark" aria-hidden="true">
              {item.number}
            </span>

            <!-- Icon -->
            <div class="w-14 h-14 rounded-2xl bg-brand-primary/8 flex items-center justify-center text-brand-primary mb-6 transition-all duration-500 group-hover:bg-brand-primary group-hover:text-white group-hover:shadow-lg group-hover:shadow-brand-primary/20">
              <item.Icon class="w-7 h-7" aria-hidden="true" />
            </div>

            <!-- Content -->
            <h3 class="text-xl font-bold text-brand-dark mb-3 transition-colors duration-300 group-hover:text-brand-primary">
              {item.title}
            </h3>
            <p class="text-base text-brand-dark-muted leading-relaxed">
              {item.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
