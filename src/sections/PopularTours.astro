---
import TourCard from "@/components/TourCard.astro";
import { getCollection } from "astro:content";

const contentTours = await getCollection("tours");

const tourImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{avif,webp,jpg,jpeg,png}",
  {
    eager: true,
  },
);

function resolveTourImage(imagePath: string) {
  const normalizedPath = imagePath.startsWith("../../assets/")
    ? imagePath.replace("../../assets/", "/src/assets/")
    : imagePath;

  return tourImages[normalizedPath]?.default;
}

const popularTourOrder = [
  "machupicchufullday",
  "city-tour-cusco",
  "valle-sagrado-de-los-incas",
  "laguna-humantay",
  "montana-de-colores-vinicunca",
  "maras-y-moray",
  "palcoyo-montana-de-colores",
  "7-lagunas-ausangate",
  "valle-sur-cusco",
];

const popularTours = popularTourOrder
  .map((id) => contentTours.find((tour) => tour.id === id))
  .filter((tour) => tour !== undefined)
  .map((tour) => ({
    title: tour.data.title,
    description: tour.data.description,
    days: tour.data.duration,
    difficulty: tour.data.difficulty,
    price: tour.data.price ?? "Consultar",
    imageSrc: resolveTourImage(tour.data.image),
    href: `/tours/${tour.id}`,
  }));
---

<section id="tours" class="py-24 px-6 bg-brand-bg">
  <div class="max-w-7xl mx-auto">
    <div class="mb-16">
      <span
        class="inline-flex items-center px-4 py-1.5 rounded-full bg-white/80 text-brand-dark text-sm font-bold mb-6 border border-brand-dark/10 shadow-soft"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-brand-primary-dark mr-2"></span>
        Experiencias Destacadas
      </span>
      <div
        class="flex flex-col md:flex-row md:items-end md:justify-between gap-6"
      >
        <h2
          class="text-4xl md:text-6xl font-medium tracking-tight text-brand-dark leading-[1.1] max-w-xl"
        >
          Tours Más <span class="text-brand-primary-dark italic">Populares</span>
        </h2>
        <a
          href="/tours"
          class="btn-travel px-8 py-4 rounded-full font-bold inline-flex items-center gap-2 shadow-lg transition-all duration-300"
        >
          Ver más paquetes
          <svg
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {popularTours.map((tour) => <TourCard {...tour} />)}
    </div>

    <div class="mt-12 text-center md:hidden">
      <a
        href="/tours"
        class="btn-travel px-8 py-4 rounded-full font-bold inline-flex items-center gap-2 shadow-lg"
      >
        Ver más paquetes
        <svg
          class="w-4 h-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      section :global(article) {
        animation: reveal both;
        animation-timeline: view();
        animation-range: entry 5% cover 30%;
      }
    }
  }

  @keyframes reveal {
    0% {
      opacity: 0;
      translate: 0 100px;
    }

    50% {
      opacity: 0.4;
    }

    to {
      opacity: 1;
      translate: 0 0;
    }
  }
</style>
