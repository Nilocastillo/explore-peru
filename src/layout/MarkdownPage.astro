---
import Layout from "@/layout/Layout.astro";

const frontmatter = Astro.props.frontmatter ?? {};
const title = frontmatter.title ?? "XPLORE PERÚ";
const description = frontmatter.description ?? "Información de XPLORE PERÚ.";
const eyebrow = frontmatter.eyebrow ?? "Información";
---

<Layout title={`${title} | XPLORE PERÚ`} description={description}>
  <main id="main-content" class="bg-brand-bg px-6 pb-20 pt-32 sm:px-8 lg:px-12">
    <article class="mx-auto max-w-4xl">
      <a href="/" class="mb-8 inline-flex w-fit items-center gap-2 rounded-full border border-brand-primary/20 bg-brand-primary/10 px-4 py-2 text-sm font-bold text-brand-primary transition hover:bg-brand-primary/15">
        <svg class="h-4 w-4" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5m0 0 7-7m-7 7 7 7"></path>
        </svg>
        Volver al inicio
      </a>

      <header class="mb-12">
        <span class="inline-flex items-center rounded-full border border-brand-primary/20 bg-brand-primary/10 px-4 py-1.5 text-sm font-black uppercase tracking-[0.14em] text-brand-primary">
          {eyebrow}
        </span>
        <h1 class="mt-6 text-4xl font-black leading-tight text-brand-dark sm:text-5xl lg:text-6xl">
          {title}
        </h1>
        {description && (
          <p class="mt-5 max-w-3xl text-lg leading-relaxed text-brand-dark-muted">
            {description}
          </p>
        )}
      </header>

      <div class="legal-copy">
        <slot />
      </div>
    </article>
  </main>
</Layout>

<style>
  .legal-copy :global(h2) {
    margin-top: 3rem;
    color: var(--color-brand-dark);
    font-size: 1.6rem;
    font-weight: 900;
    line-height: 1.2;
  }

  .legal-copy :global(h3) {
    margin-top: 2rem;
    color: var(--color-brand-dark);
    font-size: 1.15rem;
    font-weight: 900;
  }

  .legal-copy :global(p),
  .legal-copy :global(li) {
    color: var(--color-brand-dark-muted);
    font-size: 1.04rem;
    line-height: 1.85;
  }

  .legal-copy :global(p) {
    margin-top: 1rem;
  }

  .legal-copy :global(ul) {
    margin-top: 1rem;
    padding-left: 1.4rem;
    list-style: disc;
  }

  .legal-copy :global(table) {
    margin-top: 1.5rem;
    width: 100%;
    border-collapse: collapse;
    overflow: hidden;
    border-radius: 1rem;
    background: white;
    box-shadow: var(--shadow-card);
  }

  .legal-copy :global(th),
  .legal-copy :global(td) {
    border-bottom: 1px solid color-mix(in oklch, var(--color-brand-dark) 10%, transparent);
    padding: 0.9rem 1rem;
    text-align: left;
    color: var(--color-brand-dark-muted);
    vertical-align: top;
  }

  .legal-copy :global(th) {
    color: var(--color-brand-dark);
    font-weight: 900;
    background: var(--color-brand-primary-subtle);
  }

  .legal-copy :global(strong) {
    color: var(--color-brand-dark);
    font-weight: 900;
  }
</style>
