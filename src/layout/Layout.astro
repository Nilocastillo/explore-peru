---
import "../styles/global.css";
import { Font } from "astro:assets";

import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import WhatsAppButton from "@/components/WhatsAppButton.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
}

const {
  title = "XPLORE PERÚ - Viajes Extraordinarios",
  description = "XPLORE PERÚ - Agencia de viajes especializada en experiencias auténticas por Perú. Tours a Machu Picchu, Cusco, Amazonas y más.",
  image,
  type = "website",
} = Astro.props;
---

<Font cssVariable="--font-manrope" preload />
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url} />
    <meta name="theme-color" content="#0f172a" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={Astro.url} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}
    <title>{title}</title>

    <!-- International SEO (LATAM target) -->
    <link rel="alternate" hreflang="es-PE" href={Astro.url} />
    <link rel="alternate" hreflang="es-CO" href={Astro.url} />
    <link rel="alternate" hreflang="es-AR" href={Astro.url} />
    <link rel="alternate" hreflang="es-MX" href={Astro.url} />
    <link rel="alternate" hreflang="es-CL" href={Astro.url} />
    <link rel="alternate" hreflang="es" href={Astro.url} />
    <link rel="alternate" hreflang="x-default" href={Astro.url} />

    <!-- OpenGraph Additions -->
    <meta property="og:site_name" content="XPLORE PERÚ" />
    <meta property="og:locale" content="es_PE" />

    <!-- Structured Data (Organization) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "TravelAgency",
      "name": "XPLORE PERÚ",
      "description": "Agencia de viajes especializada en experiencias auténticas por Perú.",
      "url": Astro.site?.toString() ?? Astro.url.origin,
      "logo": `${Astro.site?.toString() ?? Astro.url.origin}/xplore-logo-horizontal.svg`,
      "address": {
        "@type": "PostalAddress",
        "addressCountry": "PE",
        "addressLocality": "Cusco"
      }
    })} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Saltar al contenido principal</a>
    <Header />
    <slot />
    <WhatsAppButton />
    <Footer />
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: var(--font-manrope);
    background-color: var(--color-brand-bg);
  }

  :focus-visible {
    outline: 3px solid var(--color-brand-accent);
    outline-offset: 4px;
  }

  :target {
    scroll-margin-top: 7rem;
  }

  .skip-link {
    position: fixed;
    left: 1rem;
    top: 1rem;
    z-index: 999;
    transform: translateY(-150%);
    border-radius: 999px;
    background: var(--color-brand-dark);
    color: white;
    padding: 0.75rem 1rem;
    font-weight: 800;
    transition: transform 160ms ease;
  }

  .skip-link:focus-visible {
    transform: translateY(0);
  }
</style>
